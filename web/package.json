{
  "name": "wr-docs",
  "private": true,
  "type": "module",
  "version": "0.3.0",
  "description": "The wr documentation site, built with Astro and deployed to GitHub Pages.",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "astro check && vitest run && astro build"
  },
  "engines": {
    "node": ">=20.3.0"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "github-slugger": "^2.0.0",
    "rehype-slug": "^6.0.0",
    "sharp": "^0.35.5",
    "shiki": "^3.13.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/sitemap": "^3.6.0",
    "@types/node": "^24.6.0",
    "astro": "^5.18.0",
    "typescript": "^5.9.2",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "esbuild@0.27.7": true,
    "esbuild@0.25.12": true
  }
}
