{
  "name": "wr-docs",
  "private": true,
  "type": "module",
  "version": "0.3.0",
  "description": "The wr documentation site, built with Astro and deployed to GitHub Pages.",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "astro check && vitest run && astro build"
  },
  "engines": {
    "node": ">=20.3.0"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "github-slugger": "^2.0.0",
    "rehype-slug": "^6.0.0",
    "sharp": "^0.35.5",
    "shiki": "^4.5.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/sitemap": "^3.6.0",
    "@types/node": "^26.6.4",
    "astro": "^7.3.6",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "esbuild@0.27.7": true,
    "esbuild@0.25.12": true
  }
}
