---
import Base from './Base.astro';
import { repo, withBase } from '../lib/urls';
import { siteVersion } from '../lib/version';

interface Props {
  /** Page title, also used in the document title. */
  title: string;
  description: string;
  /** Short line under the heading. */
  summary?: string;
  /** Which reference page this is: index, shortcuts, settings. */
  page?: string;
  /** Where the page comes from, shown in the meta line and the menu. */
  source?: { label: string; href: string };
}

const { title, description, summary, page = 'index', source } = Astro.props;
const version = siteVersion();
const bar = `reference / ${page}`;
---

<Base
  title={`${title} — wr docs`}
  description={description}
  path={Astro.url.pathname}
  bar={bar}
  source={source}
>
  <div class="wr-doc" data-doc="reference">
    <header class="wr-doc-head">
      <p class="wr-kicker">reference / {page}</p>
      <h1>{title}</h1>
      <p class="wr-meta">
        v{version} · generated {source ? `from ${source.label}` : 'from the repository'}
      </p>
      {summary && <p class="wr-summary">{summary}</p>}
    </header>

    <article class="prose">
      <slot />
    </article>

    <nav class="wr-pager" aria-label="Reference pages">
      <a href={withBase('/docs/reference/')}><span aria-hidden="true">[</span> reference</a>
      <a href={withBase('/docs/')}>documentation <span aria-hidden="true">]</span></a>
    </nav>

    <p class="wr-source">
      {source && <a href={source.href}>{source.label} ↗</a>}
      {source && <span aria-hidden="true"> · </span>}
      <a href={repo.issues}>report a problem ↗</a>
    </p>
  </div>
</Base>
