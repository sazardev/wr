---
import { render } from 'astro:content';
import Base from './Base.astro';
import { docEntry, docEntries, neighboursOf } from '../lib/doc-nav';
import { docMeta } from '../lib/registry';
import { docPath, repo, withBase } from '../lib/urls';
import { siteVersion } from '../lib/version';

interface Props {
  /** Document id: guide, design, performance, architecture, changelog. */
  doc: string;
  /** Section slug, or 'index' for the document overview. */
  section: string;
}

const { doc, section } = Astro.props;
const entry = await docEntry(doc, section);
const meta = docMeta(doc);
if (!entry || !meta) return Astro.redirect(withBase('/404/'));

const { Content } = await render(entry);
const entries = await docEntries(doc);
const { previous, next } = neighboursOf(entries, section);
const version = siteVersion();
const isIndex = entry.data.section === 'index';

const heading = isIndex ? entry.data.title || meta.label : entry.data.title;
const description = entry.data.summary || meta.blurb;
const bar = `${doc} / ${isIndex ? 'overview' : entry.data.section}`;
const title = isIndex ? `${meta.label} — wr docs` : `${entry.data.title} — ${meta.label} — wr docs`;
const minutes = Math.max(1, Math.round(entry.data.text.split(/\s+/).filter(Boolean).length / 200));
const position = isIndex
  ? 'overview'
  : `${String(entry.data.order).padStart(2, '0')} / ${String(entries.filter((e) => e.data.section !== 'index').length).padStart(2, '0')}`;
const source = { label: meta.file, href: repo.file(meta.file, entry.data.editAnchor) };
const hrefFor = (item: (typeof entries)[number]): string =>
  item.data.section === 'index' ? docPath(doc) : docPath(doc, item.data.section);
const markdownJson = JSON.stringify(entry.body ?? '').replace(/</g, '\\u003c');

const pageUrl = new URL(Astro.url.pathname, Astro.site).toString();
const rootId = `${new URL(withBase('/'), Astro.site)}#website`;
const jsonLd = isIndex
  ? undefined
  : [
      {
        '@type': 'TechArticle',
        '@id': `${pageUrl}#article`,
        headline: entry.data.title,
        description,
        url: pageUrl,
        mainEntityOfPage: pageUrl,
        inLanguage: 'en',
        isPartOf: { '@id': rootId },
        author: { '@type': 'Person', name: 'sazardev', url: 'https://github.com/sazardev' },
        license: 'https://opensource.org/license/mit',
        ...(entry.data.date ? { datePublished: entry.data.date } : {}),
      },
      {
        '@type': 'BreadcrumbList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: 'docs', item: new URL(withBase('/docs/'), Astro.site).toString() },
          { '@type': 'ListItem', position: 2, name: meta.label, item: new URL(docPath(doc), Astro.site).toString() },
          { '@type': 'ListItem', position: 3, name: entry.data.title, item: pageUrl },
        ],
      },
    ];
---

<Base title={title} description={description} path={Astro.url.pathname} bar={bar} source={source} jsonLd={jsonLd}>
  <div class="wr-doc" data-doc={doc}>
    <header class="wr-doc-head">
      <p class="wr-kicker">{meta.label.toLowerCase()} / {isIndex ? 'overview' : entry.data.section}</p>
      <h1>{heading}</h1>
      <p class="wr-meta">
        v{version} · {position} · {isIndex ? `${entries.filter((e) => e.data.section !== 'index').length} sections` : `${minutes} min read`} · {meta.file}
      </p>
      {!isIndex && description && <p class="wr-summary">{description}</p>}
    </header>

    <article class="prose">
      <Content />
    </article>

    {isIndex && (
      <section aria-label="Contents">
        <h2>Contents</h2>
        <div class="wr-list">
          {entries.filter((e) => e.data.section !== 'index').map((item) => (
            <a class="wr-row" href={hrefFor(item)}>
              <span class="n">{String(item.data.order).padStart(2, '0')}</span>
              <span class="label">{item.data.title}</span>
              <span class="key">{item.data.date ?? ''}</span>
            </a>
          ))}
        </div>
      </section>
    )}

    <nav class="wr-pager" aria-label="Document pages">
      {previous ? (
        <a data-prev href={hrefFor(previous)}><span aria-hidden="true">[</span> {previous.data.title}</a>
      ) : (
        <span></span>
      )}
      {next ? (
        <a data-next href={hrefFor(next)}>{next.data.title} <span aria-hidden="true">]</span></a>
      ) : (
        <span></span>
      )}
    </nav>

    <p class="wr-source">
      <a href={repo.file(meta.file, entry.data.editAnchor)}>edit this page on GitHub ↗</a>
      <span aria-hidden="true"> · </span>
      <a href={repo.issues}>report a problem ↗</a>
    </p>

    <script type="application/json" data-wr-markdown set:html={markdownJson} />
  </div>
</Base>
