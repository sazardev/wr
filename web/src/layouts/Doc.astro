---
import { render } from 'astro:content';
import Base from './Base.astro';
import Crumbs, { type Crumb } from '../components/Crumbs.astro';
import DocAside from '../components/DocAside.astro';
import DocToc from '../components/DocToc.astro';
import Pager from '../components/Pager.astro';
import { docEntry, docEntries, neighboursOf } from '../lib/doc-nav';
import { docMeta } from '../lib/registry';
import { docPath, repo, withBase } from '../lib/urls';
import { siteVersion } from '../lib/version';

interface Props {
  /** Document id: guide, design, changelog. */
  doc: string;
  /** Section slug, or 'index' for the document overview. */
  section: string;
}

const { doc, section } = Astro.props;
const entry = await docEntry(doc, section);
const meta = docMeta(doc);
if (!entry || !meta) return Astro.redirect(withBase('/404/'));

const { Content } = await render(entry);
const entries = await docEntries(doc);
const { previous, next } = neighboursOf(entries, section);
const version = siteVersion();
const isIndex = entry.data.section === 'index';

const title = isIndex ? `${entry.data.title || meta.label} — wr docs` : `${entry.data.title} — ${meta.label} — wr docs`;
const description = entry.data.summary || meta.blurb;
const crumbs: Crumb[] = [
  { label: 'docs', href: withBase('/docs/') },
  { label: meta.label.toLowerCase(), href: isIndex ? undefined : docPath(doc) },
  ...(isIndex ? [] : [{ label: entry.data.title }]),
];
// 200 words a minute is the usual figure for reading technical prose.
const minutes = Math.max(1, Math.round(entry.data.text.split(/\s+/).filter(Boolean).length / 200));
const position = isIndex ? 'overview' : `${String(entry.data.order).padStart(2, '0')} / ${String(entries.filter((e) => e.data.section !== 'index').length).padStart(2, '0')}`;
const heading = isIndex ? entry.data.title || meta.label : entry.data.title;

// Structured data for a section page: the article itself and the trail that
// leads to it (docs → document → section), mirroring the visible crumbs.
const pageUrl = new URL(Astro.url.pathname, Astro.site).toString();
const rootId = `${new URL(withBase('/'), Astro.site)}#website`;
const jsonLd = isIndex
  ? undefined
  : [
      {
        '@type': 'TechArticle',
        '@id': `${pageUrl}#article`,
        headline: entry.data.title,
        description,
        url: pageUrl,
        mainEntityOfPage: pageUrl,
        inLanguage: 'en',
        isPartOf: { '@id': rootId },
        author: { '@type': 'Person', name: 'sazardev', url: 'https://github.com/sazardev' },
        license: 'https://opensource.org/license/mit',
        ...(entry.data.date ? { datePublished: entry.data.date } : {}),
      },
      {
        '@type': 'BreadcrumbList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: 'docs', item: new URL(withBase('/docs/'), Astro.site).toString() },
          { '@type': 'ListItem', position: 2, name: meta.label, item: new URL(docPath(doc), Astro.site).toString() },
          { '@type': 'ListItem', position: 3, name: entry.data.title, item: pageUrl },
        ],
      },
    ];
---

<Base title={title} description={description} current={doc} jsonLd={jsonLd}>
  <div class="docbar">
    <b>{meta.id} / {isIndex ? 'overview' : entry.data.title}</b>
    <button type="button" data-aside-toggle aria-expanded="false" aria-controls="docs-aside">contents ▾</button>
  </div>
  <div class="docs">
    <DocAside doc={doc} section={section} entries={entries} headings={entry.data.headings} />
    <div class="doc-main">
      <Crumbs items={crumbs} />
      <header class="doc-head">
        <h1>{heading}</h1>
        {description && !isIndex && <p class="doc-sum">{description}</p>}
        <div class="doc-meta">
          <span class="tag solid"><span class="dot"></span>v{version}</span>
          <span class="tag">{position}</span>
          {!isIndex && <span class="tag">{minutes} min read</span>}
          <span class="tag">{meta.file}</span>
        </div>
      </header>
      <article class="prose">
        <Content />
      </article>
      {isIndex && <slot name="after" />}
      <Pager doc={doc} previous={previous} next={next} />
      <div class="doc-foot">
        <a href={repo.file(meta.file, entry.data.editAnchor)}>Edit this page on GitHub ↗</a>
        <a href={repo.issues}>Report a problem ↗</a>
      </div>
    </div>
    <DocToc headings={entry.data.headings} edit={repo.file(meta.file, entry.data.editAnchor)} />
  </div>
</Base>
