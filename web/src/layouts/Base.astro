---
import { ClientRouter } from 'astro:transitions';
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import sansLatin from '@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url';
import monoLatin from '@fontsource-variable/geist-mono/files/geist-mono-latin-wght-normal.woff2?url';
import CommandPalette from '../components/CommandPalette.astro';
import Gutter from '../components/Gutter.astro';
import HelpDialog from '../components/HelpDialog.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import StatusLine from '../components/StatusLine.astro';
import ThemeDialog from '../components/ThemeDialog.astro';
import { siteVersion } from '../lib/version';
import { DEFAULT_THEME, LIGHT_THEME, STORAGE_KEY, THEMES } from '../data/themes';
import { assetUrl, repo, withBase } from '../lib/urls';
import '../styles/site.css';

interface Props {
  title: string;
  description: string;
  /** Path of the page, for the canonical link. Defaults to the current one. */
  path?: string;
  /** Which header entry is current: home, docs, guide, design, changelog, reference, search. */
  current?: string;
  /** Hide the footer's closing mark on pages that bring their own ending. */
  footer?: boolean;
  /** Extra schema.org nodes appended to the site-wide JSON-LD graph. */
  jsonLd?: Record<string, unknown> | readonly Record<string, unknown>[];
  /** Robots directive; the default keeps every real page indexable. */
  robots?: string;
}

const { title, description, path, current = '', footer = true, jsonLd, robots = 'index, follow' } = Astro.props;
const version = siteVersion();
const canonical = new URL(path ?? Astro.url.pathname, Astro.site).toString();
const root = new URL(withBase('/'), Astro.site).toString();
const shareImage = new URL(assetUrl('/assets/og.png'), Astro.site).toString();
const guideUrl = new URL(withBase('/docs/guide/start/'), Astro.site).toString();
const rssUrl = new URL(withBase('/rss.xml'), Astro.site).toString();
const sitemapUrl = new URL(withBase('/sitemap-index.xml'), Astro.site).toString();
const llmsUrl = new URL(withBase('/llms.txt'), Astro.site).toString();
const icon = `data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Crect width='100' height='100' fill='%23050912'/%3E%3Ctext x='50' y='72' font-size='62' font-weight='700' text-anchor='middle' fill='%236cb4ff' font-family='monospace'%3Ew%3C/text%3E%3C/svg%3E`;

// Structured data: the site is the product page of one open-source program, so
// every page carries WebSite + SoftwareApplication and pages can append their
// own nodes (articles, breadcrumbs) through the jsonLd prop.
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${root}#website`,
      url: root,
      name: 'wr — the web, without the noise',
      description:
        'The docs and downloads of wr: a reader and browser for the terminal that fetches any page, extracts the article and renders it as formatted Markdown with per-language code highlighting.',
      inLanguage: 'en',
      license: 'https://opensource.org/license/mit',
      publisher: { '@type': 'Person', name: 'sazardev', url: 'https://github.com/sazardev' },
    },
    {
      '@type': 'SoftwareApplication',
      '@id': `${root}#app`,
      name: 'wr',
      description:
        'A reader and browser for the terminal: it fetches a page, extracts the article and renders it as formatted Markdown with per-language code highlighting, links, history, bookmarks and search.',
      url: root,
      applicationCategory: 'DeveloperApplication',
      applicationSubCategory: 'Terminal reader and browser',
      operatingSystem: 'Linux, macOS',
      softwareVersion: version,
      softwareHelp: guideUrl,
      license: 'https://opensource.org/license/mit',
      codeRepository: repo.url,
      downloadUrl: repo.latest,
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      author: { '@type': 'Person', name: 'sazardev', url: 'https://github.com/sazardev' },
      programmingLanguage: 'Go',
      inLanguage: 'en',
      keywords:
        'terminal, reader mode, markdown, syntax highlighting, CLI, TUI, terminal browser, bubbletea, open source',
    },
    ...(Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : []),
  ],
};
---

<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="dark light">
<title>{title}</title>
<meta name="description" content={description}>
<meta name="robots" content={robots}>
<meta name="author" content="sazardev">
<link rel="canonical" href={canonical}>
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:type" content="website">
<meta property="og:site_name" content="wr">
<meta property="og:locale" content="en_US">
<meta property="og:url" content={canonical}>
<meta property="og:image" content={shareImage}>
<meta property="og:image:type" content="image/png">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="wr — the web, without the noise">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={title}>
<meta name="twitter:description" content={description}>
<meta name="twitter:image" content={shareImage}>
<meta name="twitter:image:alt" content="wr — the web, without the noise">
<meta name="theme-color" content="#050912" media="(prefers-color-scheme: dark)">
<meta name="theme-color" content="#f4f7fc" media="(prefers-color-scheme: light)">
<link rel="alternate" type="application/rss+xml" title="wr releases" href={rssUrl}>
<link rel="sitemap" type="application/xml" title="Sitemap" href={sitemapUrl}>
<link rel="alternate" type="text/plain" title="llms.txt" href={llmsUrl}>
<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
<link rel="icon" href={icon}>
<link rel="preload" as="font" type="font/woff2" href={monoLatin} crossorigin>
<link rel="preload" as="font" type="font/woff2" href={sansLatin} crossorigin>
<script is:inline set:html={`
  (function () {
    var root = document.documentElement;
    root.classList.add('js');
    var ids = ${JSON.stringify(THEMES.map((t) => t.id))};
    var pick = null;
    try { pick = new URLSearchParams(location.search).get('theme'); } catch (e) {}
    if (!pick || ids.indexOf(pick) === -1) {
      try { pick = localStorage.getItem('${STORAGE_KEY}'); } catch (e) {}
    }
    if (!pick || ids.indexOf(pick) === -1) {
      pick = matchMedia('(prefers-color-scheme: light)').matches ? '${LIGHT_THEME}' : '${DEFAULT_THEME}';
    }
    root.dataset.theme = pick;
  })();
`} />
<ClientRouter />
</head>
<body>
<a class="skip" href="#main">Skip to content</a>
<Gutter />
<SiteHeader version={version} current={current} />
<div class="frame">
  <main id="main">
    <slot />
  </main>
  {footer && <SiteFooter version={version} />}
</div>
<StatusLine version={version} />
<ThemeDialog />
<CommandPalette />
<HelpDialog />
<script>
  import '../scripts/enhance';
</script>
</body>
</html>
