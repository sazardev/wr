---
// The blueprint grid of the hero and the closing sections: minor lines every
// 32px, a major line every five, drawn as an SVG pattern in the line tokens.
const { id = 'bp' } = Astro.props as { id?: string };
---

<svg class="bp" aria-hidden="true" focusable="false">
  <defs>
    <pattern id={`${id}-minor`} width="32" height="32" patternUnits="userSpaceOnUse">
      <path d="M32 0H0V32" fill="none" stroke="currentColor" stroke-width="1" />
    </pattern>
    <pattern id={`${id}-major`} width="160" height="160" patternUnits="userSpaceOnUse">
      <path d="M160 0H0V160" fill="none" stroke="currentColor" stroke-width="1" />
    </pattern>
  </defs>
  <rect width="100%" height="100%" fill={`url(#${id}-minor)`} />
  <rect class="major" width="100%" height="100%" fill={`url(#${id}-major)`} />
</svg>
