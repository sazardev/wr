---
import type { DocEntry } from '../lib/doc-nav';
import { docPath } from '../lib/urls';

interface Props {
  doc: string;
  previous: DocEntry | undefined;
  next: DocEntry | undefined;
}

const { doc, previous, next } = Astro.props;
const label = (entry: DocEntry): string => (entry.data.section === 'index' ? 'Overview' : entry.data.title);
---

<nav class="pager" aria-label="Pages of this document">
  {previous ? (
    <a href={docPath(doc, previous.data.section)} rel="prev" class="prev">
      <span class="dir"><kbd>[</kbd> previous</span>
      <span class="what"><span class="arr">←</span>{label(previous)}</span>
    </a>
  ) : (
    <span class="end">first page</span>
  )}
  {next ? (
    <a href={docPath(doc, next.data.section)} rel="next" class="next">
      <span class="dir">next <kbd>]</kbd></span>
      <span class="what">{label(next)}<span class="arr">→</span></span>
    </a>
  ) : (
    <span class="end" style="text-align:right">end of the {doc}</span>
  )}
</nav>
