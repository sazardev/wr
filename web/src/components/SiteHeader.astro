---
import Icon from './Icon.astro';
import { docPath, repo, withBase } from '../lib/urls';

interface Props {
  version: string;
  /** Which entry is current: home, docs, guide, design, changelog, reference, search. */
  current: string;
}

const { version, current } = Astro.props;

const links = [
  { href: withBase('/docs/'), label: 'Docs', key: 'docs', hint: 'start here' },
  { href: docPath('guide'), label: 'Guide', key: 'guide', hint: 'every screen, every key' },
  { href: withBase('/docs/reference/'), label: 'Reference', key: 'reference', hint: 'generated from the source' },
  { href: docPath('design'), label: 'Design', key: 'design', hint: 'the design language' },
  { href: docPath('changelog'), label: 'Changelog', key: 'changelog', hint: `v${version}` },
];
---

<header class="head">
  <div class="head-in">
    <a class="logo" href={withBase('/')} aria-label="wr, home">wr<span class="cur" aria-hidden="true"></span></a>
    <span class="tag ver">v{version}</span>
    <nav class="head-nav" aria-label="Main">
      {links.map((link) => (
        <a href={link.href} aria-current={current === link.key ? 'page' : undefined}>{link.label}</a>
      ))}
    </nav>
    <div class="head-end">
      <button
        type="button"
        class="searchbtn"
        data-palette-open
        aria-haspopup="dialog"
        aria-expanded="false"
        title="Search the docs (Ctrl+K or /)"
      >
        <Icon name="search" />
        <span class="searchbtn-t">Search the docs</span>
        <span class="searchbtn-k" aria-hidden="true"><kbd data-mod>Ctrl</kbd><kbd>K</kbd></span>
      </button>
      <button type="button" class="iconbtn" data-theme-menu aria-haspopup="dialog" aria-expanded="false" aria-label="Theme" title="Theme (t)">
        <span class="themedot" aria-hidden="true"></span>
      </button>
      <a class="iconbtn" href={repo.url} aria-label="wr on GitHub" title="GitHub"><Icon name="github" /></a>
      <button type="button" class="iconbtn menu-btn" data-nav-toggle aria-expanded="false" aria-controls="mobile-nav" aria-label="Menu">
        <span data-nav-icon="open"><Icon name="menu" /></span>
        <span data-nav-icon="close" hidden><Icon name="close" /></span>
      </button>
    </div>
  </div>
  <div class="progress" aria-hidden="true"><i data-progress></i></div>
</header>

<div class="mnav" id="mobile-nav" data-mobile-nav hidden>
  <nav aria-label="Main (mobile)">
    {links.map((link) => (
      <a href={link.href} aria-current={current === link.key ? 'page' : undefined}>
        {link.label}<small>{link.hint}</small>
      </a>
    ))}
  </nav>
  <button type="button" class="searchbtn mnav-search" data-palette-open>
    <Icon name="search" /><span style="flex:1;text-align:left">Search the docs</span>
  </button>
</div>
