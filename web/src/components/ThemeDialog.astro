---
import { THEMES } from '../data/themes';

// The theme dialog: a framed list of the palettes. It is a child of the body,
// not of the header, so it joins the document's own stacking order.
---

<div class="pal" data-theme-modal data-modal hidden>
  <div class="pal-box" role="dialog" aria-modal="true" aria-label="Theme" style="max-width:380px">
    <div class="pal-title">theme <span class="esc"><kbd>esc</kbd></span></div>
    <div class="pal-list" role="listbox" aria-label="Theme" tabindex="0" data-theme-list>
      {THEMES.map((theme) => (
        <div class="pal-opt" role="option" data-theme-option={theme.id} aria-selected="false">
          <span class="mark" aria-hidden="true">▸</span>
          <span class="nm">{theme.id}</span>
          <span class="where" style="margin-left:0">{theme.scheme}</span>
          <span class="chips" aria-hidden="true">
            {[theme.colors[0], theme.colors[1], theme.colors[3], theme.colors[4]].map((color) => (
              <i style={`background:${color}`} />
            ))}
          </span>
        </div>
      ))}
    </div>
    <div class="pal-foot">
      <span><kbd>↑</kbd><kbd>↓</kbd> preview</span>
      <span><kbd>↵</kbd> keep</span>
      <span><kbd>esc</kbd> cancel</span>
    </div>
  </div>
</div>
