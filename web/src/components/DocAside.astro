---
import type { DocEntry } from '../lib/doc-nav';
import { DOCS, docMeta } from '../lib/registry';
import { docPath, withBase } from '../lib/urls';

interface Props {
  /** guide, design, changelog or reference. */
  doc: string;
  /** Section slug, 'index', or the reference page id. */
  section: string;
  /** The sections of a document; the reference passes none. */
  entries?: readonly DocEntry[];
  headings?: readonly { depth: number; slug: string; text: string }[];
}

const { doc, section, entries = [], headings = [] } = Astro.props;
const sections = entries.filter((entry) => entry.data.section !== 'index');
const intro = entries.find((entry) => entry.data.section === 'index');

const referencePages = [
  { id: 'index', label: 'Overview', href: withBase('/docs/reference/') },
  { id: 'shortcuts', label: 'Shortcuts', href: withBase('/docs/reference/shortcuts/') },
  { id: 'settings', label: 'Settings', href: withBase('/docs/reference/settings/') },
];

const tabs = [...DOCS.map((meta) => ({ id: meta.id, href: docPath(meta.id) })), { id: 'reference', href: withBase('/docs/reference/') }];
const title = doc === 'reference' ? 'Reference' : (docMeta(doc)?.label ?? doc);
---

<aside class="aside" id="docs-aside" data-aside aria-label="Documentation navigation">
  <div class="switch">
    {tabs.map((tab) => (
      <a href={tab.href} aria-current={tab.id === doc ? 'page' : undefined}>{tab.id}</a>
    ))}
  </div>

  <div class="aside-h"><span>{title}</span><span>{doc === 'reference' ? referencePages.length : sections.length}</span></div>
  <nav class="snav" aria-label={`Pages of ${title}`}>
    {doc === 'reference' ? (
      referencePages.map((page) => (
        <a href={page.href} aria-current={section === page.id ? 'page' : undefined}>{page.label}</a>
      ))
    ) : (
      <>
        {intro && (
          <a href={docPath(doc, 'index')} aria-current={section === 'index' ? 'page' : undefined}>
            <span class="n">·</span>overview
          </a>
        )}
        {sections.map((entry) => (
          <a href={docPath(doc, entry.data.section)} aria-current={section === entry.data.section ? 'page' : undefined}>
            <span class="n">{String(entry.data.order).padStart(2, '0')}</span>{entry.data.title}
          </a>
        ))}
      </>
    )}
  </nav>

  {headings.length > 0 && (
    <div class="only-narrow">
      <div class="aside-h"><span>On this page</span></div>
      <nav class="snav" aria-label="On this page (mobile)">
        {headings.map((heading) => <a href={`#${heading.slug}`}>{heading.text}</a>)}
      </nav>
    </div>
  )}

  {doc !== 'reference' && (
    <>
      <div class="aside-h"><span>Reference</span></div>
      <nav class="snav" aria-label="Reference">
        <a href={withBase('/docs/reference/shortcuts/')}>Shortcuts</a>
        <a href={withBase('/docs/reference/settings/')}>Settings</a>
        <a href={withBase('/docs/search/')}>Search</a>
      </nav>
    </>
  )}
</aside>
