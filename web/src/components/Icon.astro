    {name === 'check' && <path d="M2.5 8.5l3.5 3.5 7.5-8" />}
    {name === 'edit' && <path d="M2 14h3l8-8-3-3-8 8zM9 4l3 3" />}
    {name === 'link' && <path d="M6.5 9.5l3-3M5 8L3.5 9.5a2.5 2.5 0 003.5 3.5L8.5 11.5M11 8l1.5-1.5A2.5 2.5 0 009 3L7.5 4.5" />}
