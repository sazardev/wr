---
import Icon from './Icon.astro';

interface Props {
  /** The command to show and copy. */
  cmd: string;
  prompt?: string;
}

const { cmd, prompt = '$' } = Astro.props;
---

<div class="cmd">
  <code><span class="p">{prompt}</span>{cmd}</code>
  <button class="copy" type="button" data-copy={cmd} aria-label={`Copy: ${cmd}`}>
    <Icon name="copy" /><span class="copy-l">copy</span>
  </button>
</div>
