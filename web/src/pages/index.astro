---
import Base from '../layouts/Base.astro';
import { DOCS } from '../lib/registry';
import { docPath, repo, withBase } from '../lib/urls';
import { siteVersion } from '../lib/version';

// The start page: the same thing wr shows when you run it with no address.
// Bookmarks are the documents; recent is the release you are reading.
const version = siteVersion();
const install = `curl -fsSL ${repo.installScript} | sh`;
---

<Base
  title="wr — a reader and browser for the terminal"
  description="wr fetches a page, extracts the article and opens it in an animated reader: formatted Markdown, syntax highlighting, links, history, bookmarks and search, from your terminal."
  path={Astro.url.pathname}
  bar="wr"
  current="home"
>
  <div class="wr-doc wr-start">
    <header class="wr-doc-head">
      <p class="wr-kicker">start page</p>
      <h1>wr</h1>
      <p class="wr-meta">v{version} · linux · macOS · MIT</p>
    </header>

    <article class="prose">
      <p class="wr-lead">
        A reader and browser for your terminal. It fetches a page, extracts the article and opens it
        in an animated reader: formatted Markdown, per-language code highlighting, clickable links,
        history, bookmarks and search. One static binary, no runtime dependencies.
      </p>

      <h2>Install</h2>
      <pre data-language="sh"><code>{install}</code></pre>
      <p>
        The installer verifies the release checksum before it puts <code>wr</code> on your
        <code>PATH</code>. Binaries for Linux and macOS, amd64 and arm64, are on
        <a href={repo.releases}>the releases page</a>.
      </p>

      <h2>Bookmarks</h2>
      <div class="wr-linklist">
        {DOCS.map((doc) => (
          <a href={docPath(doc.id)}>
            <span class="glyph" aria-hidden="true">{doc.glyph}</span>
            <span class="label">{doc.label}</span>
            <span class="desc">{doc.blurb}</span>
          </a>
        ))}
        <a href={withBase('/docs/reference/')}>
          <span class="glyph" aria-hidden="true">⣶</span>
          <span class="label">Reference</span>
          <span class="desc">Every shortcut and every setting, generated from the source.</span>
        </a>
        <a href={withBase('/docs/search/')}>
          <span class="glyph" aria-hidden="true">/</span>
          <span class="label">Search</span>
          <span class="desc">Full-text search over every page of the documentation.</span>
        </a>
      </div>

      <h2>Recent</h2>
      <div class="wr-linklist">
        <a href={docPath('changelog', `v${version}`)}>
          <span class="glyph" aria-hidden="true">⣄</span>
          <span class="label">v{version}</span>
          <span class="desc">The release this site was built from.</span>
        </a>
        <a href={docPath('guide', 'start')}>
          <span class="glyph" aria-hidden="true">⣿</span>
          <span class="label">Start reading</span>
          <span class="desc">Install wr and read your first page in the guide.</span>
        </a>
        <a href={repo.url}>
          <span class="glyph" aria-hidden="true">↗</span>
          <span class="label">Source on GitHub</span>
          <span class="desc">The Go source, the issues and the pull requests.</span>
        </a>
      </div>

      <p class="wr-dim">
        Press <kbd>o</kbd> to open an address or search, <kbd>m</kbd> for the menu,
        <kbd>?</kbd> for every key. The frame is the reader: scroll it, search it, follow its links.
      </p>
    </article>
  </div>
</Base>
