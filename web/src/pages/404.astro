---
import Base from '../layouts/Base.astro';
import { withBase } from '../lib/urls';

// The 404 page, as the reader draws an error: a failed load and the ways out.
// The inline script keeps the old static-site addresses working.
const base = withBase('/');
---

<Base title="Not found — wr docs" description="That page does not exist. The documentation starts at /docs." robots="noindex, follow" bar="404">
  <div class="wr-doc">
    <header class="wr-doc-head">
      <p class="wr-kicker">error / 404</p>
      <h1>✗ that page is not here</h1>
      <p class="wr-meta">the address did not resolve to a page of this site</p>
    </header>

    <article class="prose">
      <p>
        The documentation was rebuilt with one page per section. Whatever you were looking for is
        one of these, or you can search it.
      </p>
      <div class="wr-linklist">
        <a href={withBase('/docs/')}>
          <span class="glyph" aria-hidden="true">⣿</span>
          <span class="label">Documentation</span>
          <span class="desc">Every document, one page per section.</span>
        </a>
        <a href={withBase('/docs/guide/start/')}>
          <span class="glyph" aria-hidden="true">⣶</span>
          <span class="label">Start reading</span>
          <span class="desc">Install wr and read your first page.</span>
        </a>
        <a href={withBase('/docs/search/')}>
          <span class="glyph" aria-hidden="true">/</span>
          <span class="label">Search</span>
          <span class="desc">Full-text search over every page.</span>
        </a>
        <a href={withBase('/')}>
          <span class="glyph" aria-hidden="true">⡇</span>
          <span class="label">Start page</span>
          <span class="desc">The reader’s own home.</span>
        </a>
      </div>
      <p class="wr-dim">Press <kbd>o</kbd> to open an address, <kbd>m</kbd> for the menu, <kbd>?</kbd> for every key.</p>
    </article>
  </div>
</Base>

<script is:inline define:vars={{ base, docsBase: withBase('/docs/') }}>
  var moved = {
    '/guide.html': 'guide/',
    '/design.html': 'design/',
    '/index.html': '/',
    '/docs/guide.html': 'guide/',
    '/docs/design.html': 'design/',
    '/docs/GUIDE.md': 'guide/',
    '/docs/DESIGN.md': 'design/'
  };
  var path = location.pathname.replace(/\/$/, '') || '/';
  if (moved[path]) location.replace(base + moved[path]);
  if (path.indexOf('/docs/') === 0) {
    var doc = path.replace(/^\/docs\//, '').split('/')[0];
    location.replace(docsBase + doc + '/');
  }
</script>
