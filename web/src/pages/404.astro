---
import Base from '../layouts/Base.astro';
import Blueprint from '../components/Blueprint.astro';
import { withBase } from '../lib/urls';

// The 404 page. It doubles as the compatibility shim for the addresses of the
// old static site (guide.html, design.html), which now have deep routes: the
// script below runs on every 404 and moves the visitor to the new address.

const base = withBase('/');
---

<Base title="Not found — wr docs" description="That page does not exist. The documentation starts at /docs." robots="noindex, follow">
  <section class="nf">
    <Blueprint id="nf" />
    <div class="nf-in">
      <p class="code rise">404<span class="cur"></span></p>
      <h1 class="rise" style="--d:1">That page is not here.</h1>
      <p class="lead rise" style="--d:2">
        The documentation was rebuilt with one page per section. Whatever you were looking for is
        one of these — or press <kbd>/</kbd> and search for it.
      </p>
      <div class="btn-row rise" style="--d:3">
        <a class="btn primary" href={withBase('/docs/')}>Documentation <span class="arr">→</span></a>
        <a class="btn" href={withBase('/docs/guide/start/')}>Start reading</a>
        <a class="btn" href={withBase('/docs/search/')}>Search</a>
        <a class="btn ghost" href={withBase('/')}>Home</a>
      </div>
    </div>
  </section>

  <script is:inline define:vars={{ base, docsBase: withBase('/docs/') }}>
    // Addresses of the previous static site, and where they live now.
    var moved = {
      '/guide.html': 'guide/',
      '/design.html': 'design/',
      '/index.html': '/',
      '/docs/guide.html': 'guide/',
      '/docs/design.html': 'design/',
      '/docs/GUIDE.md': 'guide/',
      '/docs/DESIGN.md': 'design/'
    };
    var path = location.pathname.replace(/\/$/, '') || '/';
    if (moved[path]) location.replace(base + moved[path]);
    if (path.indexOf('/docs/') === 0) {
      // /docs/guide/anything-that-moved -> the document's first section
      var doc = path.replace(/^\/docs\//, '').split('/')[0];
      location.replace(docsBase + doc + '/');
    }
  </script>
</Base>
