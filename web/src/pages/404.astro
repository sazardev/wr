---
import Base from '../layouts/Base.astro';
import { withBase } from '../lib/urls';

// The 404 page. It doubles as the compatibility shim for the addresses of the
// old static site (guide.html, design.html), which now have deep routes: the
// script below runs on every 404 and moves the visitor to the new address.

const base = withBase('/');
---

<Base title="Not found — wr docs" description="That page does not exist. The documentation starts at /docs.">
  <div class="wrap notfound">
    <span class="glyph">⠿</span>
    <h1>That page is not here.</h1>
    <p class="lead">
      The documentation was rebuilt as an Astro site with one page per section. Whatever you were
      looking for is one of these:
    </p>
    <div class="links">
      <a class="btn primary" href={withBase('/docs/')}><span class="k">⣿</span> Documentation</a>
      <a class="btn" href={withBase('/docs/guide/start/')}><span class="k">⡇</span> Start reading</a>
      <a class="btn" href={withBase('/docs/search/')}><span class="k">⣶</span> Search</a>
      <a class="btn" href={withBase('/')}><span class="k">⣄</span> Home</a>
    </div>
  </div>

  <script is:inline define:vars={{ base, docsBase: withBase('/docs/') }}>
    // Addresses of the previous static site, and where they live now.
    var moved = {
      '/guide.html': 'guide/',
      '/design.html': 'design/',
      '/index.html': '/',
      '/docs/guide.html': 'guide/',
      '/docs/design.html': 'design/',
      '/docs/GUIDE.md': 'guide/',
      '/docs/DESIGN.md': 'design/'
    };
    var path = location.pathname.replace(/\/$/, '') || '/';
    if (moved[path]) location.replace(base + moved[path]);
    if (path.indexOf('/docs/') === 0) {
      // /docs/guide/anything-that-moved -> the document's first section
      var doc = path.replace(/^\/docs\//, '').split('/')[0];
      location.replace(docsBase + doc + '/');
    }
  </script>
</Base>
