---
import Base from '../../layouts/Base.astro';

// /docs/search/?q= — a TUI search page. The index is the same JSON the address
// bar uses; the query lives in the URL so a search is a link.
---

<Base
  title="Search — wr docs"
  description="Search the wr documentation: the guide, the design notes, performance, architecture, the changelog and the reference."
  path={Astro.url.pathname}
  bar="search"
  current="search"
>
  <div class="wr-doc" data-search-page>
    <header class="wr-doc-head">
      <p class="wr-kicker">search</p>
      <h1>Search</h1>
      <p class="wr-meta">full-text · in your browser · every page of the documentation</p>
    </header>

    <form class="wr-searchform" data-search-form role="search">
      <span class="wr-prompt" aria-hidden="true">/</span>
      <input
        class="wr-input"
        type="text"
        name="q"
        data-search-input
        placeholder="links, keys, cache, install…"
        aria-label="Search the documentation"
        autocomplete="off"
        spellcheck="false"
        autofocus
      >
      <span class="wr-find-count" data-search-status aria-live="polite"></span>
    </form>

    <p class="wr-note">
      <kbd>↑</kbd> <kbd>↓</kbd> choose · <kbd>enter</kbd> open · <kbd>esc</kbd> clear.
      The same index opens with <kbd>o</kbd> from any page.
    </p>

    <div class="wr-results" data-search-results aria-live="polite">
      <div class="wr-empty">Type a word: links, keys, cache, install…</div>
    </div>
  </div>
</Base>
