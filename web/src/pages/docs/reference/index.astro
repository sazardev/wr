---
import Page from '../../../layouts/Page.astro';
import RuleBar from '../../../components/RuleBar.astro';
import { withBase } from '../../../lib/urls';
import { repo } from '../../../lib/urls';

// /docs/reference/ — the generated pages: shortcuts, settings and the paths wr
// keeps things in. None of this is typed by hand; each page is built from the
// file the program itself uses.

const pages = [
  {
    glyph: '⣤',
    title: 'Shortcuts',
    href: withBase('/docs/reference/shortcuts/'),
    text: 'Every default key binding, grouped like the program’s shortcuts panel, generated from keys.go.',
    source: 'keys.go',
  },
  {
    glyph: '⣶',
    title: 'Settings',
    href: withBase('/docs/reference/settings/'),
    text: 'Every option of config.toml with its default and what it does, generated from the README table.',
    source: 'README.md',
  },
  {
    glyph: '⣷',
    title: 'Where wr keeps things',
    href: withBase('/docs/reference/settings/#where-things-live'),
    text: 'The config file, the page cache, the history and the bookmarks — and how to clear them.',
    source: 'README.md',
  },
];
---

<Page
  title="Reference"
  description="Generated reference of wr: every key binding from keys.go and every setting from the README."
  glyph="⣿"
  summary="Three pages the site builds for you, so they cannot fall behind the program."
  source={{ label: 'keys.go + README.md', href: repo.url }}
>
  <section style="padding-top:6px">
    <div class="sec-head">
      <span class="glyph">⡇</span>
      <h2>GENERATED, NOT WRITTEN</h2>
    </div>
    <RuleBar fill={20} />
    <div class="cards">
      {pages.map((page) => (
        <a class="card" href={page.href}>
          <div class="top">
            <span class="glyph">{page.glyph}</span>
            <h3>{page.title}</h3>
            <span class="meta">{page.source}</span>
          </div>
          <p>{page.text}</p>
          <span class="go">open ▸</span>
        </a>
      ))}
    </div>
  </section>

  <section style="padding-top:52px">
    <div class="sec-head">
      <span class="glyph">⣀</span>
      <h2>READ IT IN THE GUIDE</h2>
    </div>
    <RuleBar fill={16} />
    <div class="cards">
      <a class="card" href={withBase('/docs/guide/rebinding-keys/')}>
        <div class="top"><span class="glyph">⣿</span><h3>Rebinding keys</h3></div>
        <p>Change any binding from inside the program, or in config.toml under [keys].</p>
        <span class="go">guide ▸</span>
      </a>
      <a class="card" href={withBase('/docs/guide/make-it-yours/')}>
        <div class="top"><span class="glyph">⡇</span><h3>Make it yours</h3></div>
        <p>The settings panel, ~30 options applied live and saved for you.</p>
        <span class="go">guide ▸</span>
      </a>
    </div>
  </section>
</Page>
