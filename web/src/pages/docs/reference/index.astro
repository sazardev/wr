---
import Page from '../../../layouts/Page.astro';
import { settingRows, shortcutGroups } from '../../../lib/reference';
import { repo, withBase } from '../../../lib/urls';

const shortcuts = shortcutGroups().reduce((sum, group) => sum + group.items.length, 0);
const settings = settingRows().length;

const pages = [
  { label: 'Shortcuts', href: withBase('/docs/reference/shortcuts/'), desc: `All ${shortcuts} default key bindings, grouped like the program’s shortcuts panel.`, meta: 'keys.go' },
  { label: 'Settings', href: withBase('/docs/reference/settings/'), desc: `All ${settings} options of config.toml with their defaults and what each one does.`, meta: 'README.md' },
  { label: 'Where wr keeps things', href: withBase('/docs/reference/settings/#where-things-live'), desc: 'The config, the page cache, the history and the bookmarks — and how to clear them.', meta: 'README.md' },
];
---

<Page
  title="Reference"
  description="Generated reference of wr: every key binding from keys.go and every setting from the README."
  summary="Pages the site builds for you from the program’s own files, so they cannot fall behind it."
  source={{ label: 'keys.go + README.md', href: repo.url }}
>
  <h2>Generated pages</h2>
  <div class="wr-linklist">
    {pages.map((page) => (
      <a href={page.href}>
        <span class="glyph" aria-hidden="true">⣶</span>
        <span class="label">{page.label}</span>
        <span class="desc">{page.desc} · {page.meta}</span>
      </a>
    ))}
  </div>

  <h2>Read it in the guide</h2>
  <div class="wr-linklist">
    <a href={withBase('/docs/guide/rebinding-keys/')}>
      <span class="glyph" aria-hidden="true">⣿</span>
      <span class="label">Rebinding keys</span>
      <span class="desc">Change any binding from inside the program, or in config.toml under [keys].</span>
    </a>
    <a href={withBase('/docs/guide/make-it-yours/')}>
      <span class="glyph" aria-hidden="true">⣿</span>
      <span class="label">Make it yours</span>
      <span class="desc">The settings panel: the options, applied live and saved for you.</span>
    </a>
    <a href={withBase('/docs/guide/troubleshooting/')}>
      <span class="glyph" aria-hidden="true">⣿</span>
      <span class="label">Troubleshooting</span>
      <span class="desc">When something does not look right: the usual causes and their fixes.</span>
    </a>
  </div>
</Page>
