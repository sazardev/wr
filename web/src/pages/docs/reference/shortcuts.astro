---
import Page from '../../../layouts/Page.astro';
import { shortcutGroups } from '../../../lib/reference';
import { cellText, tableUnderHeading } from '../../../lib/tables';
import { readReadme } from '../../../lib/repo';
import { repo, withBase } from '../../../lib/urls';
import Icon from '../../../components/Icon.astro';

// /docs/reference/shortcuts/ — every default key binding, grouped like the
// program's shortcuts panel, parsed from keys.go. The mouse table comes from
// the README. Both are the sources the program is built from.

const groups = shortcutGroups();
const mouse = tableUnderHeading(readReadme(), 'Mouse');
const total = groups.reduce((sum, group) => sum + group.items.length, 0);
const all = total + (mouse?.rows.length ?? 0);
---

<Page
  title="Shortcuts"
  page="shortcuts"
  description="Every default key binding of wr, grouped like the program's shortcuts panel and generated from keys.go."
  summary={`${total} actions in ${groups.length} groups, plus the mouse. Generated from keys.go — the same file the program binds keys from.`}
  source={{ label: 'keys.go', href: repo.file('keys.go') }}
>
  <div class="tools-row">
    <label class="filter">
      <Icon name="search" />
      <input type="search" data-filter-input placeholder="Filter: back, search, ctrl…" aria-label="Filter the shortcuts" autocomplete="off" spellcheck="false" />
      <span class="count" data-filter-count aria-live="polite">{all}</span>
    </label>
  </div>

  <div class="ref-grid">
    {groups.map((group) => (
      <div class="ref-group" data-filter-group>
        <h3><span>{group.group}</span><span class="count">{group.items.length}</span></h3>
        {group.items.map((item) => (
          <div class="ref-row" data-filter-row>
            <div class="keys">
              {item.keys.map((key) => <kbd>{key}</kbd>)}
              {item.keys.length === 0 && <span class="aid">no default key</span>}
            </div>
            <div class="label">{item.label}<span class="aid">{item.id}</span></div>
          </div>
        ))}
      </div>
    ))}

    {mouse && (
      <div class="ref-group" data-filter-group>
        <h3><span>Mouse</span><span class="count">{mouse.rows.length}</span></h3>
        {mouse.rows.map((row) => (
          <div class="ref-row" data-filter-row>
            <div class="keys">{(row[0] ?? '').split(/\s*\/\s*/).map((key) => <kbd>{cellText(key)}</kbd>)}</div>
            <div class="label">{cellText(row[1] ?? '')}</div>
          </div>
        ))}
      </div>
    )}
  </div>
  <div class="ref-empty" data-filter-empty hidden>No binding matches that. Try a shorter word.</div>

  <p class="note-line">
    Rebind any of them from the menu (<kbd>m</kbd>) or the shortcuts panel (<kbd>,</kbd>):
    see <a href={withBase('/docs/guide/rebinding-keys/')}>Rebinding keys</a>.
  </p>
</Page>
