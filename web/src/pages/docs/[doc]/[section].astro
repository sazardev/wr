---
import Doc from '../../../layouts/Doc.astro';
import { docEntries } from '../../../lib/doc-nav';
import { DOCS } from '../../../lib/registry';

// /docs/<doc>/<section>/ — a deep route: one page per `##` heading of the
// document, generated by the content loader from the repository Markdown.

export async function getStaticPaths() {
  const paths: { params: { doc: string; section: string } }[] = [];
  for (const meta of DOCS) {
    const entries = await docEntries(meta.id);
    for (const entry of entries) {
      if (entry.data.section === 'index') continue;
      paths.push({ params: { doc: meta.id, section: entry.data.section } });
    }
  }
  return paths;
}

const { doc, section } = Astro.params;
---

<Doc doc={doc} section={section} />
