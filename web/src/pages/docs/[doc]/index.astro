---
import Doc from '../../../layouts/Doc.astro';
import { DOCS } from '../../../lib/registry';

// /docs/<doc>/ — the overview of a document: its intro, then its sections.
export async function getStaticPaths() {
  return DOCS.map((meta) => ({ params: { doc: meta.id } }));
}

const { doc } = Astro.params;
---

<Doc doc={doc} section="index" />
