---
import Doc from '../../../layouts/Doc.astro';
import SectionCards from '../../../components/SectionCards.astro';
import SceneGallery from '../../../components/SceneGallery.astro';
import RuleBar from '../../../components/RuleBar.astro';
import { docEntries } from '../../../lib/doc-nav';
import { DOCS } from '../../../lib/registry';
import { docMeta } from '../../../lib/registry';

// /docs/<doc>/ — the overview of a document: its intro, then one card per
// section, each linking to that section's own page.

export async function getStaticPaths() {
  return DOCS.map((meta) => ({ params: { doc: meta.id } }));
}

const { doc } = Astro.params;
const meta = docMeta(doc);
if (!meta) return Astro.redirect('/404/');
const entries = await docEntries(doc);
---

<Doc doc={doc} section="index">
  <SectionCards slot="after" doc={doc} entries={entries} />
  <section slot="after">
    <div class="sec-head">
      <span class="glyph">⣶</span>
      <h2>THE UI, RECORDED</h2>
      <span class="note">regenerated by scripts/capture.sh</span>
    </div>
    <RuleBar fill={22} />
    <SceneGallery />
  </section>
</Doc>
