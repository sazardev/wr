---
import Base from '../../layouts/Base.astro';
import { DOCS } from '../../lib/registry';
import { docEntries } from '../../lib/doc-nav';
import { docPath, repo, withBase } from '../../lib/urls';
import { siteVersion } from '../../lib/version';

const version = siteVersion();
const lists = await Promise.all(
  DOCS.map(async (meta) => ({
    meta,
    pages: (await docEntries(meta.id)).filter((entry) => entry.data.section !== 'index'),
  })),
);

const quick = [
  { label: 'Start here', href: withBase('/docs/guide/start/'), desc: 'Install wr and read your first page.' },
  { label: 'Every shortcut', href: withBase('/docs/reference/shortcuts/'), desc: 'The keys, grouped like the program’s own panel.' },
  { label: 'Every setting', href: withBase('/docs/reference/settings/'), desc: 'The whole config.toml, with defaults.' },
  { label: 'Performance', href: docPath('performance'), desc: 'The benchmark suite and where the milliseconds go.' },
];
---

<Base
  title="Documentation — wr"
  description="The wr documentation: the guide, the design of the site, performance, architecture, the changelog and the generated reference."
  path={Astro.url.pathname}
  bar="docs"
  current="docs"
>
  <div class="wr-doc">
    <header class="wr-doc-head">
      <p class="wr-kicker">docs / index</p>
      <h1>Documentation</h1>
      <p class="wr-meta">v{version} · {DOCS.length} documents · every page is a section of a file in the repository</p>
      <p class="wr-summary">
        Everything wr can do, one page at a time. The guide and the changelog are the files that
        ship with the program; the reference is generated from its source.
      </p>
    </header>

    <article class="prose">
      <h2>Start here</h2>
      <div class="wr-linklist">
        {quick.map((item) => (
          <a href={item.href}>
            <span class="glyph" aria-hidden="true">⣿</span>
            <span class="label">{item.label}</span>
            <span class="desc">{item.desc}</span>
          </a>
        ))}
      </div>

      <h2>Documents</h2>
      <div class="wr-linklist">
        {lists.map(({ meta, pages }) => (
          <a href={docPath(meta.id)}>
            <span class="glyph" aria-hidden="true">{meta.glyph}</span>
            <span class="label">{meta.label}</span>
            <span class="desc">{meta.blurb} · {pages.length} pages</span>
          </a>
        ))}
      </div>

      <h2>Where it comes from</h2>
      <p>
        The guide and the design notes are Markdown files in the repository; the changelog is
        written by release-please; the reference is parsed from <code>keys.go</code> and the
        README. Nothing on this site is typed twice.
      </p>
      <div class="wr-linklist">
        <a href={repo.file('docs/GUIDE.md')}>
          <span class="glyph" aria-hidden="true">↗</span>
          <span class="label">docs/GUIDE.md</span>
          <span class="desc">The guide, also inside every release tarball.</span>
        </a>
        <a href={repo.file('keys.go')}>
          <span class="glyph" aria-hidden="true">↗</span>
          <span class="label">keys.go</span>
          <span class="desc">The file the program binds keys from.</span>
        </a>
        <a href={repo.file('web')}>
          <span class="glyph" aria-hidden="true">↗</span>
          <span class="label">web/</span>
          <span class="desc">This site: an Astro app that draws the reader’s TUI in a browser.</span>
        </a>
      </div>

      <p class="wr-dim">
        Press <kbd>o</kbd> to open a page by name, <kbd>/</kbd> to search this page,
        <kbd>t</kbd> for its headings, <kbd>m</kbd> for the menu.
      </p>
    </article>
  </div>
</Base>
