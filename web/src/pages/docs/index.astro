---
import Base from '../../layouts/Base.astro';
import Blueprint from '../../components/Blueprint.astro';
import Icon from '../../components/Icon.astro';
import Label from '../../components/Label.astro';
import { DOCS } from '../../lib/registry';
import { docEntries } from '../../lib/doc-nav';
import { settingRows, shortcutGroups } from '../../lib/reference';
import { docPath, repo, withBase } from '../../lib/urls';
import { siteVersion } from '../../lib/version';

// /docs/ — the documentation hub: search first, three doors in, then every
// document with its pages listed. Nothing here is typed twice: the counts and
// the lists come from the same files the pages do.

const version = siteVersion();
const shortcuts = shortcutGroups().reduce((sum, group) => sum + group.items.length, 0);
const settings = settingRows().length;

const lists = await Promise.all(
  DOCS.map(async (meta) => ({
    meta,
    pages: (await docEntries(meta.id)).filter((entry) => entry.data.section !== 'index'),
  })),
);

const quick = [
  { no: '01', title: 'Start here', text: 'Install wr and read your first page: the screen, the keys, the first link you follow.', href: withBase('/docs/guide/start/'), go: 'guide / start' },
  { no: '02', title: 'Every shortcut', text: `All ${shortcuts} default bindings, grouped like the program’s own panel and parsed from keys.go.`, href: withBase('/docs/reference/shortcuts/'), go: 'reference / shortcuts' },
  { no: '03', title: 'Every setting', text: `The whole config.toml: ${settings} options with their defaults and what each one does.`, href: withBase('/docs/reference/settings/'), go: 'reference / settings' },
];
---

<Base
  title="Documentation — wr"
  description="The wr documentation: the guide, the design language, the changelog and the generated reference. Every page is one section of a file in the repository."
  current="docs"
>
  <section class="hub-head">
    <Blueprint id="hub" />
    <div class="hub-in">
      <div class="hero-tags rise" style="display:flex;gap:8px;margin-bottom:24px">
        <span class="tag solid"><span class="dot"></span>v{version}</span>
        <span class="tag">built from the repository</span>
      </div>
      <h1 class="rise" style="--d:1">Documentation</h1>
      <p class="lead rise" style="--d:2">
        Everything wr can do, one page at a time. The guide and the changelog are the very files
        that ship with the program; the reference is generated from its source.
      </p>
      <button type="button" class="hub-search rise" style="--d:3" data-palette-open>
        <Icon name="search" /><span>Search every page…</span><kbd data-mod>Ctrl</kbd><kbd>K</kbd>
      </button>
    </div>
  </section>

  <section class="sheet">
    <div class="sheet-in">
      <Label no="01" title="Start" note="three doors in" />
      <div class="hub-quick">
        {quick.map((card, i) => (
          <a href={card.href} class="rv" style={`--d:${i}`}>
            <span class="no">{card.no}</span>
            <h2>{card.title}</h2>
            <p>{card.text}</p>
            <span class="go">{card.go} <span class="arr">→</span></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="sheet">
    <div class="sheet-in">
      <Label no="02" title="Every document" note={`${DOCS.length} documents`} />
      <div class="hub-cols">
        {lists.map(({ meta, pages }, i) => (
          <div class="hub-col rv" style={`--d:${i}`}>
            <h2><a href={docPath(meta.id)}>{meta.label}</a><small>{pages.length} pages</small></h2>
            <p>{meta.blurb}</p>
            <ol>
              {pages.slice(0, 8).map((entry) => (
                <li>
                  <a href={docPath(meta.id, entry.data.section)}>
                    <span class="n">{entry.data.date ? '·' : String(entry.data.order).padStart(2, '0')}</span>{entry.data.title}
                  </a>
                </li>
              ))}
            </ol>
            {pages.length > 8 && <a class="more" href={docPath(meta.id)}>+ {pages.length - 8} more →</a>}
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="sheet">
    <div class="sheet-in">
      <Label no="03" title="Where it comes from" note="nothing is typed twice" />
      <div class="hub-quick">
        <a href={repo.file('docs/GUIDE.md')} class="rv">
          <span class="no">docs/GUIDE.md</span><h2>The guide</h2>
          <p>Ships inside every release tarball and is the source of every guide page here.</p>
          <span class="go">view on GitHub <span class="arr">↗</span></span>
        </a>
        <a href={repo.file('keys.go')} class="rv" style="--d:1">
          <span class="no">keys.go</span><h2>The shortcuts</h2>
          <p>The file the program binds keys from: the reference page is parsed out of it at build time.</p>
          <span class="go">view on GitHub <span class="arr">↗</span></span>
        </a>
        <a href={repo.file('web')} class="rv" style="--d:2">
          <span class="no">web/</span><h2>This site</h2>
          <p>An Astro app: a content loader, one page per section, deployed to GitHub Pages.</p>
          <span class="go">view on GitHub <span class="arr">↗</span></span>
        </a>
      </div>
    </div>
  </section>
</Base>
