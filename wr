#!/usr/bin/env -S uv run --quiet --script
# /// script
# requires-python = ">=3.11"
# dependencies = ["markdownify>=0.13", "pygments"]
# ///
"""wr: modo lector para terminal. Descarga una pagina, se queda con el articulo,
lo convierte a Markdown y lo muestra: la prosa con bat y cada bloque de codigo
con pygments por lenguaje, ambos en colores ANSI del tema de la terminal.

  wr URL            lee el articulo en un pager (q para salir)
  wr -L URL         igual, sin las URL de los enlaces (solo el texto)
  wr --md URL       imprime el Markdown tal cual (para pipes, glow, etc.)
  wr archivo.html   tambien funciona con un archivo local

El lenguaje de cada bloque se toma de data-language / clases language-xx /
highlight-source-xx, que es justo lo que otros extractores descartan.
"""
import argparse
import os
import re
import shutil
import subprocess
import sys
from urllib.parse import urljoin

from bs4 import BeautifulSoup
from markdownify import MarkdownConverter
from pygments import highlight
from pygments.formatters import TerminalFormatter
from pygments.lexers import TextLexer, get_lexer_by_name
from pygments.util import ClassNotFound

UA = "Mozilla/5.0 (X11; Linux x86_64) wr/1.0"
MAX_BYTES = 8_000_000
DROP = ["script", "style", "noscript", "nav", "aside", "footer", "form", "svg",
        "button", "iframe", "template", "dialog", "select", "input"]
LANG_RE = [
    re.compile(r"(?:^|\s)(?:language|lang|highlight-source|brush)[-:_ ]+([\w+#.-]+)", re.I),
    re.compile(r"(?:^|\s)sourceCode\s+([\w+#-]+)", re.I),
]
JUNK_CLASS = re.compile(r"(?:^|[\s_-])(?:toc|table-of-contents|breadcrumbs?|sidebar|cookie\w*)(?:$|[\s_-])", re.I)
CODE_JUNK = re.compile(r"line-?no|linenum|gutter|copy|clipboard", re.I)
# nombre en la pagina -> nombre que bat entiende en un fence de Markdown
LANG_MAP = {"shell": "bash", "sh": "bash", "zsh": "bash", "console": "bash",
            "shellsession": "bash", "golang": "go", "js": "javascript",
            "ts": "typescript", "yml": "yaml", "py": "python", "docker": "dockerfile",
            "text": "", "plaintext": "", "txt": ""}


def fetch(src):
    if src.startswith(("http://", "https://")):
        # curl: mismo almacen de certificados que el sistema (urllib de Python 3.14
        # rechaza algunas cadenas validas, p.ej. Netlify) y verificacion siempre activa.
        p = subprocess.run(["curl", "-sSL", "--max-time", "20", "--max-filesize",
                            str(MAX_BYTES), "-A", UA, src], capture_output=True, timeout=30)
        if p.returncode != 0:
            sys.exit(f"wr: no se pudo descargar: {p.stderr.decode('utf-8', 'replace').strip()}")
        return p.stdout.decode("utf-8", "replace")
    with open(src.removeprefix("file://"), "rb") as f:
        return f.read(MAX_BYTES).decode("utf-8", "replace")


def lang_of(pre):
    for el in [pre, pre.find("code"), *list(pre.parents)[:3]]:
        if el is None or not hasattr(el, "get"):
            continue
        lang = el.get("data-language") or el.get("data-lang")
        if not lang:
            cls = " ".join(el.get("class") or [])
            for rx in LANG_RE:
                m = rx.search(cls)
                if m:
                    lang = m.group(1)
                    break
        if lang:
            lang = lang.lower()
            return LANG_MAP.get(lang, lang)
    return ""


def article(html, base=""):
    soup = BeautifulSoup(html, "html.parser")
    title = soup.title.get_text(" ", strip=True) if soup.title else ""
    root = soup.find("article") or soup.find("main") or soup.body or soup
    for t in DROP:
        for el in root.find_all(t):
            el.decompose()
    if root.name != "article":
        for el in root.find_all("header"):
            el.decompose()
    for el in root.find_all(class_=JUNK_CLASS):
        el.decompose()
    for el in root.select("pre *"):
        if el.name and CODE_JUNK.search(" ".join(el.get("class") or [])):
            el.decompose()
    for img in root.find_all("img"):
        alt = (img.get("alt") or "").strip()
        # sin alt, o alt que solo repite el titulo (portada): no aporta nada
        dup = alt and title and alt.lower() in title.lower()
        img.replace_with(f"[imagen: {alt}]" if alt and not dup else "")
    if base.startswith("http"):
        for a in root.find_all("a", href=True):
            a["href"] = urljoin(base, a["href"])
    return title, root


def to_markdown(root, title, keep_links):
    conv = MarkdownConverter(
        heading_style="ATX", bullets="-", code_language_callback=lang_of,
        escape_underscores=False, escape_asterisks=False, escape_misc=False,
        strip=None if keep_links else ["a"])
    text = conv.convert_soup(root)
    # filas que son solo enlaces (etiquetas, migas, menus): ruido en modo lector
    text = re.sub(r"^(?:\[[^\]]*\]\([^)]*\)[ \t]*){4,}$", "", text, flags=re.M)
    text = re.sub(r"[ \t]+\n", "\n", text)
    text = re.sub(r"\n{3,}", "\n\n", text).strip() + "\n"
    # el contenido de la pagina es no confiable: fuera secuencias de control
    # (ESC, etc.) para que no puedan manipular tu terminal.
    text = re.sub(r"[\x00-\x08\x0b-\x1f\x7f-\x9f]", "", text)
    if title and not re.search(r"^#\s", text, re.M):
        text = f"# {title}\n\n{text}"
    return text


FENCE = re.compile(r"^```([\w+#.-]*)\n(.*?)\n```$", re.S | re.M)
ANSI = re.compile(r"\x1b\[[0-9;]*m")
PLACEHOLDER = re.compile(r"@@CODE(\d+)@@")
DIM, BOLD, OFF = "\033[90m", "\033[1m", "\033[0m"


def code_block(lang, code):
    """Bloque de codigo coloreado con los 16 colores ANSI (siguen el tema)."""
    try:
        lexer = get_lexer_by_name(lang) if lang else TextLexer()
    except ClassNotFound:
        lexer = TextLexer()
    fmt = TerminalFormatter(bg=os.environ.get("WR_BG", "dark"))
    body = highlight(code, lexer, fmt).rstrip("\n").split("\n")
    head = f"{DIM}\u256d\u2500 {OFF}{BOLD}{lang or 'texto'}{OFF}"
    return "\n".join([head, *(f"{DIM}\u2502{OFF} {ln}" for ln in body), f"{DIM}\u2570\u2500{OFF}"])


def render(md):
    """Prosa con bat; los bloques de codigo se sustituyen por los de pygments
    (bat no colorea codigo embebido en fences de Markdown)."""
    blocks = []

    def stash(m):
        blocks.append((m.group(1).lower(), m.group(2)))
        return f"@@CODE{len(blocks) - 1}@@"

    prose = FENCE.sub(stash, md)
    if shutil.which("bat"):
        prose = subprocess.run(
            ["bat", "-l", "markdown", "--theme", "ansi", "--style", "plain",
             "--paging", "never", "--color", "always"],
            input=prose, text=True, capture_output=True).stdout
    out = []
    for line in prose.split("\n"):
        m = PLACEHOLDER.search(ANSI.sub("", line))
        out.append(code_block(*blocks[int(m.group(1))]) if m else line)
    return "\n".join(out)


def main():
    ap = argparse.ArgumentParser(description="Modo lector para terminal (HTML -> Markdown -> bat).")
    ap.add_argument("src", help="URL o archivo HTML")
    ap.add_argument("-L", "--no-links", action="store_true", help="sin las URL de los enlaces")
    ap.add_argument("--md", action="store_true", help="imprime el Markdown sin pasar por bat")
    args = ap.parse_args()

    title, root = article(fetch(args.src), args.src)
    md = to_markdown(root, title, keep_links=not args.no_links)
    if args.md:
        sys.stdout.write(md)
        return
    text = render(md)
    if sys.stdout.isatty() and shutil.which("less"):
        subprocess.run(["less", "-R", "-i", "-M"], input=text, text=True)
    else:
        sys.stdout.write(text)


if __name__ == "__main__":
    main()
