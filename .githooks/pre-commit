#!/bin/sh
# Pre-commit: format the staged Go files, then vet and test.
#
# Enabled with:  sh scripts/setup-hooks.sh
set -eu

cd "$(git rev-parse --show-toplevel)"

staged="$(git diff --cached --name-only --diff-filter=ACM -- '*.go')"
if [ -z "$staged" ]; then
	exit 0
fi

printf '%s\n' "$staged" | while IFS= read -r file; do
	[ -f "$file" ] || continue
	gofmt -w "$file"
	git add "$file"
done

go vet ./...
go test ./...
